@page
@model ConfirmEmailModel

@{
    ViewData["Title"] = "Xác nhận Email";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom text-center">
                @if (Model.IsSucceeded)
                {
                    <div class="bg-success text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-check-lg fs-4"></i>
                    </div>
                }
                else
                {
                    <div class="bg-danger text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                        <i class="bi bi-x-lg fs-4"></i>
                    </div>
                }
                <h5 class="fw-bold text-dark mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body p-4 text-center">
                <div class="alert @(Model.IsSucceeded ? "alert-success" : "alert-danger") small mb-4" role="alert">
                    <i class="bi @(Model.IsSucceeded ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                    @Model.StatusMessage
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <a asp-page="./Login" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập ngay
                    </a>
                    @if (!Model.IsSucceeded)
                    {
                        <a asp-page="./ResendEmailConfirmation" class="btn btn-outline-secondary btn-sm px-3">
                            <i class="bi bi-envelope-arrow-up me-1"></i> Gửi lại email
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
