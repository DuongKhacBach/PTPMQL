@page
@model LockoutModel

@{
    ViewData["Title"] = "Tài khoản tạm bị khóa";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom text-center">
                <div class="bg-danger text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-lock-fill fs-4"></i>
                </div>
                <h5 class="fw-bold text-danger mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="mb-3">
                    Tài khoản của bạn đã bị khóa tạm thời trong <strong>5 phút</strong> do nhập sai mật khẩu quá <strong>5 lần</strong> liên tiếp.
                </p>
                <p class="text-muted small mb-4">
                    Vui lòng chờ hết thời gian khóa rồi thử đăng nhập lại, hoặc sử dụng chức năng Quên mật khẩu nếu bạn không nhớ mật khẩu hiện tại.
                </p>
                <div class="d-flex justify-content-center flex-wrap gap-2">
                    <a asp-page="./Login" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                    </a>
                    <a asp-page="./ForgotPassword" class="btn btn-outline-secondary btn-sm px-3">
                        <i class="bi bi-key me-1"></i> Quên mật khẩu?
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
