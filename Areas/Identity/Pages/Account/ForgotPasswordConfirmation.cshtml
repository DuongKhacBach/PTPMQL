@page
@model ForgotPasswordConfirmationModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Đã gửi email đặt lại mật khẩu";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom text-center">
                <div class="bg-primary text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center mb-2" style="width: 48px; height: 48px;">
                    <i class="bi bi-envelope-paper-heart-fill fs-4"></i>
                </div>
                <h5 class="fw-bold text-dark mb-0">@ViewData["Title"]</h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="mb-3">
                    Nếu địa chỉ email bạn nhập đã được đăng ký và xác nhận trên hệ thống, chúng tôi đã gửi một liên kết đặt lại mật khẩu đến hộp thư của bạn.
                </p>
                <p class="text-muted small mb-4">
                    Vui lòng kiểm tra hộp thư đến (hoặc thư mục Spam / Thư rác) và làm theo hướng dẫn.
                </p>

                @if (Env.IsDevelopment())
                {
                    <div class="alert alert-info text-start small mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <strong>Development:</strong> Nếu chưa cấu hình SMTP Gmail, kiểm tra tệp <code>.eml</code> trong thư mục <code>mailsSave/</code>.
                    </div>
                }

                <a asp-page="./Login" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>
