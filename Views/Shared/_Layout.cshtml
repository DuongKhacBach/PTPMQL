@inject IAuthorizationService AuthorizationService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool canViewStudents = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.Index)).Succeeded;
    bool canViewFaculties = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Faculty.Index)).Succeeded;
    bool canViewAccounts = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Account.Index)).Succeeded;
    bool canViewRoles = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Role.Index)).Succeeded;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DemoMVC</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- 1. Base CSS: site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- 2. Custom Styles: custom.css -->
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
</head>
<body>
    <!-- Header & Navigation -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light main-navbar">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-code-slash text-primary"></i>
                    <span>DemoMVC</span>
                </a>
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door"></i> Trang chủ
                            </a>
                        </li>
                        @if (canViewStudents)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Student" ? "active" : "")" asp-controller="Student" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Quản lý Sinh viên
                                </a>
                            </li>
                        }
                        @if (canViewFaculties)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Faculty" ? "active" : "")" asp-controller="Faculty" asp-action="Index">
                                    <i class="bi bi-building"></i> Quản lý Khoa
                                </a>
                            </li>
                        }
                        @if (canViewAccounts)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Account" ? "active" : "")" asp-controller="Account" asp-action="Index">
                                    <i class="bi bi-person-gear text-danger"></i> Quản lý Tài khoản
                                </a>
                            </li>
                        }
                        @if (canViewRoles)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Role" ? "active" : "")" asp-controller="Role" asp-action="Index">
                                    <i class="bi bi-shield-lock text-danger"></i> Quản lý Role
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Toast Notification Container (dùng cho phản hồi AJAX CRUD) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" id="appToastContainer" style="z-index: 1090;"></div>

    <!-- Main Content Container -->
    <main role="main" class="container py-4">
        @RenderBody()
    </main>

    <!-- Shared Bootstrap 5 CRUD Modal (dùng chung cho Student, Faculty, Role, Account & Import Excel) -->
    <div class="modal fade" id="crudModal" tabindex="-1" aria-labelledby="crudModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" id="crudModalDialog">
            <div class="modal-content border-0 shadow-lg rounded-3" id="crudModalContent">
                <!-- PartialView sẽ được nạp động qua AJAX -->
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-2 mb-md-0">
                    <span>&copy; 2026 - <strong>DemoMVC</strong>. Phát triển ứng dụng Web ASP.NET Core MVC.</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">
                        <i class="bi bi-shield-lock"></i> Chính sách bảo mật
                    </a>
                    <a href="https://github.com/DuongKhacBach/PTPMQL" target="_blank" rel="noopener noreferrer">
                        <i class="bi bi-github"></i> GitHub Repo
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <!-- JavaScript Bundle (jQuery + Bootstrap 5 Bundle JS + site.js + crud-modal.js) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/crud-modal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
