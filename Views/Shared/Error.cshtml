@model ErrorViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5">
            <div class="text-danger mb-3">
                <i class="bi bi-exclamation-octagon-fill display-3"></i>
            </div>
            <h4 class="fw-bold text-danger mb-2">Đã xảy ra lỗi hệ thống</h4>
            <p class="text-muted small mb-3">
                Rất tiếc, đã có sự cố phát sinh trong quá trình xử lý yêu cầu của bạn. Vui lòng thử lại sau.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="alert alert-light border small mb-4">
                    <strong>Mã tra cứu lỗi (Request ID):</strong> <code>@Model.RequestId</code>
                </div>
            }

            @if (Env.IsDevelopment())
            {
                <div class="alert alert-warning text-start small mb-4">
                    <i class="bi bi-terminal me-1"></i>
                    <strong>Môi trường Development:</strong> Kiểm tra cửa sổ log Console của ứng dụng để xem chi tiết ngoại lệ (Stack Trace).
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-house-door me-1"></i> Về Trang chủ
                </a>
                <button type="button" onclick="location.reload()" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
                </button>
            </div>
        </div>
    </div>
</div>
