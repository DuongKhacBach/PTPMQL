@model DemoMVC.Models.ViewModels.AssignRoleVM

@{
    ViewData["Title"] = "Gán Quyền (Role) cho Tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-person-check-fill text-primary me-2"></i>@ViewData["Title"]
                </h5>
                <small class="text-muted">
                    Tài khoản: <strong class="text-primary">@Model.UserEmail</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.FullName))
                    {
                        <span>(@Model.FullName)</span>
                    }
                </small>
            </div>
            <div class="card-body p-4">
                <form asp-action="AssignRole" method="post">
                    <input type="hidden" asp-for="UserId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold small mb-2">Chọn các quyền (Roles) cho người dùng:</label>
                        @if (Model.AllRoles != null && Model.AllRoles.Any())
                        {
                            <div class="list-group">
                                @foreach (var role in Model.AllRoles)
                                {
                                    bool isChecked = Model.SelectedRoles != null && Model.SelectedRoles.Contains(role.Name);
                                    <label class="list-group-item d-flex align-items-center gap-2 cursor-pointer">
                                        <input class="form-check-input me-1"
                                               type="checkbox"
                                               name="SelectedRoles"
                                               value="@role.Name"
                                               @(isChecked ? "checked" : "") />
                                        <span class="fw-semibold">@role.Name</span>
                                    </label>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning small">Chưa có Role nào được khởi tạo.</div>
                        }
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-check-lg me-1"></i> Lưu phân quyền
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

