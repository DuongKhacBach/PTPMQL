@model DemoMVC.Models.PaginatedList<DemoMVC.Models.ViewModels.UserWithRoleVM>
@inject IAuthorizationService AuthorizationService
@inject Microsoft.AspNetCore.Identity.UserManager<DemoMVC.Models.ApplicationUser> UserManager

@{
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentRoleFilter = ViewData["CurrentRoleFilter"] as string;
    var currentPageSize = ViewData["CurrentPageSize"] is int ps ? ps : (Model?.PageSize ?? 10);

    bool canAssignRole = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Account.AssignRole)).Succeeded;
    bool canApprove = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Account.Approve)).Succeeded;
    bool canDeleteAccount = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Account.Delete)).Succeeded;
    var currentUserId = UserManager.GetUserId(User);
}

<div data-total-items="@(Model?.TotalItems ?? 0)" data-current-filter="@(currentFilter ?? string.Empty)">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="text-center py-2" style="width: 70px;">STT</th>
                        <th class="ps-3 py-2">Họ và tên</th>
                        <th class="py-2">Email / Tài khoản</th>
                        <th class="py-2">Mã SV / Mã CB</th>
                        <th class="py-2">Tư cách</th>
                        <th class="py-2">Trạng thái</th>
                        <th class="py-2">Quyền hiện tại (Roles)</th>
                        <th class="text-end pe-3 py-2" style="width: 230px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var u = item.User;
                            var userRoles = item.Roles ?? new List<string>();
                            bool isLecturerType = u.UserType == "GiangVien";
                            bool isPending = !u.IsApproved;
                            bool isStudentAccount = !userRoles.Contains("Admin") && !userRoles.Contains("GiangVien")
                                                    && u.UserType != "Admin" && !(isLecturerType && u.IsApproved)
                                                    && u.Id != currentUserId;
                            var code = !string.IsNullOrWhiteSpace(u.StudentCode) ? u.StudentCode : u.StaffCode;
                            var (typeText, typeClass) = u.UserType switch
                            {
                                "Admin" => ("Quản trị", "bg-danger-subtle text-danger border-danger-subtle"),
                                "GiangVien" => ("Giảng viên / Cán bộ", "bg-warning-subtle text-warning-emphasis border-warning-subtle"),
                                _ => ("Sinh viên", "bg-info-subtle text-info-emphasis border-info-subtle")
                            };
                            <tr>
                                <td class="text-center fw-semibold text-secondary small" style="width: 70px;">@item.Stt</td>
                                <td class="ps-3 fw-semibold text-dark">
                                    @(string.IsNullOrWhiteSpace(u.FullName) ? "Chưa cập nhật" : u.FullName)
                                    @if (!u.EmailConfirmed)
                                    {
                                        <div class="small text-muted fw-normal"><i class="bi bi-envelope-exclamation me-1"></i>Email chưa xác thực</div>
                                    }
                                </td>
                                <td>
                                    <span class="font-monospace small text-primary">@u.Email</span>
                                </td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(code))
                                    {
                                        <span class="text-muted small fst-italic">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">@code</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @typeClass border px-2 py-1">@typeText</span>
                                </td>
                                <td>
                                    @if (isPending)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt GV</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check-circle-fill me-1"></i>Đã duyệt</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Roles != null && item.Roles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var role in item.Roles)
                                            {
                                                var badgeClass = role == "Admin"
                                                    ? "bg-danger-subtle text-danger border-danger-subtle"
                                                    : role == "GiangVien"
                                                        ? "bg-warning-subtle text-warning-emphasis border-warning-subtle"
                                                        : "bg-info-subtle text-info-emphasis border-info-subtle";
                                                <span class="badge @badgeClass border px-2 py-1">@role</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa gán quyền</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (canApprove && isPending && isLecturerType)
                                        {
                                            <button type="button"
                                                    class="btn btn-success btn-sm px-2"
                                                    data-modal-url="@Url.Action("ApproveLecturer", "Account", new { userId = u.Id })"
                                                    title="Duyệt Giảng viên">
                                                <i class="bi bi-patch-check me-1"></i>Duyệt GV
                                            </button>
                                        }
                                        @if (canAssignRole)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm px-2"
                                                    data-modal-url="@Url.Action("AssignRole", "Account", new { userId = u.Id })"
                                                    title="Gán Role">
                                                <i class="bi bi-key me-1"></i>Gán Role
                                            </button>
                                        }
                                        @if (canDeleteAccount && isStudentAccount)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm px-2"
                                                    data-modal-url="@Url.Action("Delete", "Account", new { userId = u.Id })"
                                                    title="Xóa tài khoản">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block text-secondary mb-2"></i>
                                @if (!string.IsNullOrEmpty(currentFilter) || !string.IsNullOrEmpty(currentRoleFilter))
                                {
                                    <span>Không tìm thấy tài khoản nào khớp với bộ lọc hiện tại.</span>
                                    <div class="mt-2">
                                        <a asp-action="Index" asp-route-pageSize="@currentPageSize"
                                           data-ajax-link="true" data-ajax-clear-filter="true"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-arrow-clockwise me-1"></i> Xóa bộ lọc
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span>Chưa có tài khoản nào trong hệ thống.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Thanh phân trang (Pagination Footer) -->
    @if (Model != null && Model.TotalItems > 0)
    {
        <div class="card-footer bg-white py-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Hiển thị <strong>@Model.StartItemIndex</strong> - <strong>@Model.EndItemIndex</strong> trong tổng số <strong>@Model.TotalItems</strong> tài khoản
                <span class="ms-1 text-secondary">(Trang @Model.PageIndex / @Model.TotalPages)</span>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang danh sách tài khoản">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="1"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               asp-route-roleFilter="@currentRoleFilter"
                               data-ajax-link="true"
                               title="Trang đầu">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               asp-route-roleFilter="@currentRoleFilter"
                               data-ajax-link="true">
                                <i class="bi bi-chevron-left"></i> Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@currentPageSize"
                                   asp-route-searchString="@currentFilter"
                                   asp-route-roleFilter="@currentRoleFilter"
                                   data-ajax-link="true">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               asp-route-roleFilter="@currentRoleFilter"
                               data-ajax-link="true">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@Model.TotalPages"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               asp-route-roleFilter="@currentRoleFilter"
                               data-ajax-link="true"
                               title="Trang cuối">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
