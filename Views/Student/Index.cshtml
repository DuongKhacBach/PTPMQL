@model DemoMVC.Models.PaginatedList<DemoMVC.Models.Student>
@inject IAuthorizationService AuthorizationService

@{
    ViewData["Title"] = "Quản lý Sinh viên";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentFaculty = ViewData["CurrentFaculty"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
    var currentPageSize = ViewData["CurrentPageSize"] is int ps ? ps : (Model?.PageSize ?? 5);
    int[] pageSizeOptions = new[] { 5, 10, 20, 50 };

    bool canCreate = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.Create)).Succeeded;
    bool canExport = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.ExportExcel)).Succeeded;
    bool canImport = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.ImportExcel)).Succeeded;
    bool canViewFaculties = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Faculty.Index)).Succeeded;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 rounded-3 mb-3" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card shadow-sm border-0 rounded-3">
    <!-- Header & Công cụ tìm kiếm LINQ -->
    <div class="card-header bg-white py-3 border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-people-fill fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Danh sách Sinh viên</h5>
                    <small class="text-muted">
                        Tìm thấy <strong data-total-count-target>@(Model?.TotalItems ?? 0)</strong> sinh viên
                        <span data-filter-keyword-target class="@(string.IsNullOrEmpty(currentFilter) ? "d-none" : "")">
                            @if (!string.IsNullOrEmpty(currentFilter))
                            {
                                <span>với từ khóa <mark class="px-1 rounded">"@currentFilter"</mark></span>
                            }
                        </span>
                    </small>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (canImport)
                {
                    <button type="button"
                            class="btn btn-outline-success btn-sm px-3 rounded-2"
                            data-modal-url="@Url.Action("ImportExcel", "Student")"
                            data-modal-size="modal-lg">
                        <i class="bi bi-upload me-1"></i> Nhập Excel
                    </button>
                }
                @if (canExport)
                {
                    <a id="btnExportExcel"
                       data-export-base-url="@Url.Action("ExportExcel", "Student")"
                       asp-action="ExportExcel"
                       asp-route-searchString="@currentFilter"
                       asp-route-facultyId="@currentFaculty"
                       asp-route-sortOrder="@currentSort"
                       class="btn btn-success btn-sm px-3 rounded-2">
                        <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
                    </a>
                }
                @if (canViewFaculties)
                {
                    <a asp-controller="Faculty" asp-action="Index" class="btn btn-outline-primary btn-sm px-3 rounded-2">
                        <i class="bi bi-building me-1"></i> Quản lý Khoa
                    </a>
                }
                @if (canCreate)
                {
                    <button type="button"
                            class="btn btn-primary btn-sm px-3 rounded-2"
                            data-modal-url="@Url.Action("Create", "Student")"
                            data-modal-size="modal-lg">
                        <i class="bi bi-plus-lg me-1"></i> Thêm mới
                    </button>
                }
            </div>
        </div>

        <!-- Thanh tìm kiếm, Lọc Khoa & Chọn số dòng/trang sử dụng AJAX -->
        <form asp-action="Index" method="get" data-ajax-filter="true" class="row g-2 align-items-center">
            <input type="hidden" name="sortOrder" value="@currentSort" />
            <div class="col-md-5 col-lg-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@currentFilter"
                           class="form-control border-start-0 ps-0"
                           placeholder="Tìm kiếm theo Tên, Mã SV, Khoa, SĐT..." />
                    <button type="submit" class="btn btn-primary px-3">
                        Tìm kiếm
                    </button>
                    <a asp-action="Index" asp-route-pageSize="@currentPageSize"
                       data-ajax-link="true" data-ajax-clear-filter="true"
                       class="btn btn-outline-secondary @(string.IsNullOrEmpty(currentFilter) && string.IsNullOrEmpty(currentFaculty) ? "d-none" : "")"
                       title="Xóa tìm kiếm">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
            <div class="col-md-3 col-lg-3">
                <select name="facultyId" asp-items="ViewBag.FacultyList" class="form-select form-select-sm" data-ajax-autosubmit="true">
                    <option value="">-- Tất cả Khoa --</option>
                </select>
            </div>
            <div class="col-md-4 col-lg-5 d-flex flex-wrap justify-content-md-end align-items-center gap-3">
                <div class="d-flex align-items-center gap-2 small text-muted">
                    <label for="pageSizeSelect" class="mb-0 text-nowrap">Hiển thị:</label>
                    <select id="pageSizeSelect" name="pageSize" class="form-select form-select-sm py-1" style="width: auto;" data-ajax-autosubmit="true">
                        @foreach (var size in pageSizeOptions)
                        {
                            <option value="@size" selected="@(size == currentPageSize ? "selected" : null)">@size dòng / trang</option>
                        }
                    </select>
                </div>
                <div class="text-muted small d-none d-xl-block">
                    <i class="bi bi-info-circle me-1"></i> Bấm tiêu đề cột để <strong>sắp xếp</strong>
                </div>
            </div>
        </form>
    </div>

    <!-- Container bảng dữ liệu được nạp/cập nhật động bằng AJAX -->
    <div id="dataTableContainer">
        @await Html.PartialAsync("_StudentTablePartial", Model)
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
