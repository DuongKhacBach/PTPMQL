@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Chỉnh sửa Sinh viên";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <!-- Header Form -->
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-3">
                <div class="bg-warning-subtle text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-pencil-square fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Chỉnh sửa thông tin Sinh viên</h5>
                    <small class="text-muted">Cập nhật dữ liệu cho sinh viên mã <strong>@Model.StudentId</strong></small>
                </div>
            </div>

            <!-- Body Form -->
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <!-- Row 1: Mã SV (Readonly) & Khoa Dropdown -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StudentId" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-lock-fill text-secondary"></i>
                                </span>
                                <input asp-for="StudentId" class="form-control border-start-0 ps-0 bg-light font-monospace fw-bold text-primary" readonly />
                            </div>
                            <small class="text-muted d-block mt-1" style="font-size: 0.8rem;">
                                <i class="bi bi-info-circle me-1"></i>Khóa chính không thể thay đổi
                            </small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="FacultyId" class="form-label fw-semibold text-dark small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0">
                                    <i class="bi bi-building"></i>
                                </span>
                                <select asp-for="FacultyId" asp-items="ViewBag.FacultyList" class="form-select border-start-0 ps-0" required>
                                    <option value="">-- Chọn Khoa --</option>
                                </select>
                            </div>
                            <span asp-validation-for="FacultyId" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <!-- Row 2: Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-person"></i>
                            </span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nhập họ và tên..." />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Row 3: Số điện thoại -->
                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold text-dark small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted border-end-0">
                                <i class="bi bi-telephone"></i>
                            </span>
                            <input asp-for="PhoneNumber" type="tel" class="form-control border-start-0 ps-0" placeholder="Nhập số điện thoại..." />
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-2">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning px-4 py-2 rounded-2 shadow-sm fw-semibold text-dark">
                            <i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
