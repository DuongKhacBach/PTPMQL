@model DemoMVC.Models.Student
@inject IAuthorizationService AuthorizationService
@{
    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.Edit)).Succeeded;
}

<div class="modal-header bg-info text-white">
    <h5 class="modal-title fw-bold" id="crudModalLabel">
        <i class="bi bi-info-circle-fill me-2"></i>Thông tin Chi tiết Sinh viên
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<div class="modal-body p-4">
    <div class="list-group list-group-flush border rounded-2">
        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small fw-semibold"><i class="bi bi-person-badge me-2 text-primary"></i>Mã sinh viên (ID):</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 font-monospace fs-6">
                @Model.StudentId
            </span>
        </div>
        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small fw-semibold"><i class="bi bi-person me-2 text-secondary"></i>Họ và tên:</span>
            <span class="fw-bold text-dark">@Model.FullName</span>
        </div>
        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small fw-semibold"><i class="bi bi-building me-2 text-secondary"></i>Khoa:</span>
            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                @(Model.Faculty != null ? $"{Model.Faculty.FacultyName} (Mã ngành: {Model.Faculty.FacultyCode})" : "Chưa phân khoa")
            </span>
        </div>
        <div class="list-group-item d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small fw-semibold"><i class="bi bi-telephone me-2 text-secondary"></i>Số điện thoại:</span>
            <span class="text-secondary font-monospace">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
        </div>
    </div>
</div>

<div class="modal-footer bg-light d-flex justify-content-between">
    <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
        <i class="bi bi-x-lg me-1"></i> Đóng
    </button>
    @if (canEdit)
    {
        <button type="button"
                class="btn btn-warning btn-sm px-3 fw-semibold text-dark"
                data-modal-url="@Url.Action("Edit", "Student", new { id = Model.StudentId })"
                data-modal-size="modal-lg">
            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
        </button>
    }
</div>
