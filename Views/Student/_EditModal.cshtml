@model DemoMVC.Models.Student

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title fw-bold" id="crudModalLabel">
        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin Sinh viên
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<form asp-controller="Student" asp-action="Edit" asp-route-id="@Model.StudentId" method="post" data-ajax-form="true" autocomplete="off">
    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="alert alert-danger py-2 small d-none" data-modal-error role="alert"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="StudentId" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-lock-fill text-secondary"></i>
                    </span>
                    <input asp-for="StudentId" class="form-control border-start-0 ps-0 bg-light font-monospace fw-bold text-primary" readonly />
                </div>
                <small class="text-muted d-block mt-1" style="font-size: 0.78rem;">
                    <i class="bi bi-info-circle me-1"></i>Khóa chính không thể thay đổi
                </small>
            </div>
            <div class="col-md-6">
                <label asp-for="FacultyId" class="form-label fw-semibold text-dark small"></label>
                <div class="input-group">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-building"></i>
                    </span>
                    <select asp-for="FacultyId" asp-items="ViewBag.FacultyList" class="form-select border-start-0 ps-0" required>
                        <option value="">-- Chọn Khoa --</option>
                    </select>
                </div>
                <span asp-validation-for="FacultyId" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label fw-semibold text-dark small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-person"></i>
                </span>
                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Nhập họ và tên..." />
            </div>
            <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
        </div>

        <div class="mb-2">
            <label asp-for="PhoneNumber" class="form-label fw-semibold text-dark small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light text-muted border-end-0">
                    <i class="bi bi-telephone"></i>
                </span>
                <input asp-for="PhoneNumber" type="tel" inputmode="numeric" maxlength="11" pattern="^0\d{9,10}$"
                       data-digits-only="true"
                       class="form-control border-start-0 ps-0 font-monospace" placeholder="Nhập số điện thoại (10-11 chữ số)..." required />
            </div>
            <span asp-validation-for="PhoneNumber" class="text-danger small mt-1 d-block"></span>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">
            <i class="bi bi-x-lg me-1"></i> Hủy
        </button>
        <button type="submit" class="btn btn-warning btn-sm px-4 fw-semibold text-dark">
            <i class="bi bi-check2-circle me-1"></i> Cập nhật thay đổi
        </button>
    </div>
</form>
