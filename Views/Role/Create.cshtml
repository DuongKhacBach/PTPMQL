@{
    ViewData["Title"] = "Thêm Role mới";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-plus-circle text-primary me-2"></i>@ViewData["Title"]
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                    <div class="mb-3">
                        <label for="roleName" class="form-label fw-semibold small">Tên Role</label>
                        <input type="text" id="roleName" name="roleName" class="form-control" placeholder="VD: Admin, GiangVien, SinhVien..." required />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Hủy</a>
                        <button type="submit" class="btn btn-primary btn-sm px-3">
                            <i class="bi bi-check-lg me-1"></i> Lưu Role
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

