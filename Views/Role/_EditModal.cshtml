@model Microsoft.AspNetCore.Identity.IdentityRole

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title fw-bold" id="crudModalLabel">
        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Role
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<form asp-controller="Role" asp-action="Edit" asp-route-id="@Model.Id" method="post" data-ajax-form="true" autocomplete="off">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="modal-body p-4">
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <div class="alert alert-danger py-2 small d-none" data-modal-error role="alert"></div>

        <div class="mb-3">
            <label class="form-label text-muted small">Role ID</label>
            <input type="text" class="form-control font-monospace bg-light" value="@Model.Id" disabled />
        </div>
        <div class="mb-2">
            <label for="roleName" class="form-label fw-semibold small">Tên Role <span class="text-danger">*</span></label>
            <input type="text" id="roleName" name="roleName" value="@Model.Name" class="form-control" required />
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-warning btn-sm px-4 fw-semibold text-dark">
            <i class="bi bi-save me-1"></i> Cập nhật
        </button>
    </div>
</form>
