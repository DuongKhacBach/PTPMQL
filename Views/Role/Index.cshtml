@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole>

@{
    ViewData["Title"] = "Quản lý Role";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                <i class="bi bi-shield-lock-fill fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-0">Danh sách Quyền (Roles)</h5>
                <small class="text-muted">Tổng cộng <strong>@(Model?.Count() ?? 0)</strong> vai trò trong hệ thống</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Account" asp-action="Index" class="btn btn-outline-primary btn-sm px-3 rounded-2">
                <i class="bi bi-people me-1"></i> Quản lý Tài khoản
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm px-3 rounded-2">
                <i class="bi bi-plus-lg me-1"></i> Thêm Role mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success m-3 py-2 small" role="alert">
            <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger m-3 py-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 py-2.5" style="width: 340px;">Role ID</th>
                        <th class="py-2.5">Tên Role</th>
                        <th class="text-end pe-3 py-2.5" style="width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-3 font-monospace small text-muted">@role.Id</td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-semibold">
                                        <i class="bi bi-award me-1"></i>@role.Name
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-outline-warning btn-sm py-1 px-2" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-outline-danger btn-sm py-1 px-2" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">Chưa có Role nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

