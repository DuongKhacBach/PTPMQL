@model DemoMVC.Models.ViewModels.RoleClaimVM

@{
    ViewData["Title"] = $"Phân quyền cho Role {Model.RoleName}";
    var groupedClaims = Model.Claims
        .Select((claim, index) => new { Claim = claim, Index = index })
        .GroupBy(x => x.Claim.Group)
        .ToList();
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-sliders text-primary me-2"></i>Phân quyền động cho Role: <span class="text-primary">@Model.RoleName</span>
                    </h5>
                    <small class="text-muted">Cấu hình chi tiết các quyền (Permission Claims) trong bảng AspNetRoleClaims</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
            <div class="card-body p-4" data-permission-matrix="true">
                <form asp-action="AssignClaim" method="post">
                    <input type="hidden" asp-for="RoleId" />
                    <input type="hidden" asp-for="RoleName" />

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2" data-total-selected-badge>
                            @Model.Claims.Count(c => c.Selected) / @Model.Claims.Count quyền đã chọn
                        </span>
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-success" data-select-all-permissions="true">Chọn tất cả</button>
                            <button type="button" class="btn btn-outline-secondary" data-select-all-permissions="false">Bỏ chọn tất cả</button>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        @foreach (var group in groupedClaims)
                        {
                            <div class="col-12" data-permission-group="@group.Key">
                                <div class="card border shadow-none">
                                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark small">@group.Key</span>
                                            <span class="badge bg-primary-subtle text-primary rounded-pill" data-group-count-badge>
                                                @group.Count(x => x.Claim.Selected)/@group.Count()
                                            </span>
                                        </div>
                                        <div class="btn-group btn-group-sm">
                                            <button type="button" class="btn btn-outline-primary py-0 px-2" data-select-group="@group.Key" data-check-state="true">Chọn nhóm</button>
                                            <button type="button" class="btn btn-outline-secondary py-0 px-2" data-select-group="@group.Key" data-check-state="false">Bỏ chọn nhóm</button>
                                        </div>
                                    </div>
                                    <div class="card-body py-2 px-3">
                                        <div class="row g-2">
                                            @foreach (var item in group)
                                            {
                                                var i = item.Index;
                                                <div class="col-md-6">
                                                    <input type="hidden" name="Claims[@i].Type" value="@item.Claim.Type" />
                                                    <input type="hidden" name="Claims[@i].Value" value="@item.Claim.Value" />
                                                    <input type="hidden" name="Claims[@i].DisplayName" value="@item.Claim.DisplayName" />
                                                    <input type="hidden" name="Claims[@i].Group" value="@item.Claim.Group" />
                                                    <label class="border rounded-2 p-2 d-flex align-items-start gap-2 h-100 bg-white" for="standalone_claim_@i">
                                                        <input class="form-check-input permission-checkbox mt-1 flex-shrink-0"
                                                               type="checkbox"
                                                               id="standalone_claim_@i"
                                                               name="Claims[@i].Selected"
                                                               value="true"
                                                               @(item.Claim.Selected ? "checked" : null) />
                                                        <div class="small">
                                                            <div class="fw-semibold text-dark">@item.Claim.DisplayName</div>
                                                            <div class="text-muted" style="font-size: 0.78rem;">@item.Claim.Description</div>
                                                            <code class="text-primary" style="font-size: 0.72rem;">@item.Claim.Value</code>
                                                        </div>
                                                    </label>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Hủy</a>
                        <button type="submit" class="btn btn-primary btn-sm px-4">
                            <i class="bi bi-check-lg me-1"></i> Lưu thay đổi phân quyền
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
