@model Microsoft.AspNetCore.Identity.IdentityRole

@{
    ViewData["Title"] = "Xóa Role";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="fw-bold text-danger mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa Role
                </h5>
            </div>
            <div class="card-body p-4">
                <p class="mb-3">Bạn có chắc chắn muốn xóa vai trò <strong>@Model.Name</strong> khỏi hệ thống không?</p>
                <dl class="row small mb-3">
                    <dt class="col-sm-4 text-muted">Role ID:</dt>
                    <dd class="col-sm-8 font-monospace">@Model.Id</dd>
                    <dt class="col-sm-4 text-muted">Tên Role:</dt>
                    <dd class="col-sm-8 fw-bold text-primary">@Model.Name</dd>
                </dl>
                <form asp-action="Delete" method="post" class="d-flex justify-content-end gap-2">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Hủy</a>
                    <button type="submit" class="btn btn-danger btn-sm px-3">
                        <i class="bi bi-trash me-1"></i> Xác nhận xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

