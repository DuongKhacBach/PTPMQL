@model DemoMVC.Models.PaginatedList<DemoMVC.Models.ViewModels.RoleListItemVM>
@inject IAuthorizationService AuthorizationService

@{
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentPageSize = ViewData["CurrentPageSize"] is int ps ? ps : (Model?.PageSize ?? 10);
    int totalSystemPermissions = SystemPermissions.GetAll().Count;

    bool canEdit = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Role.Edit)).Succeeded;
    bool canDelete = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Role.Delete)).Succeeded;
    bool canAssignClaim = (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Role.AssignClaim)).Succeeded;
}

<div data-total-items="@(Model?.TotalItems ?? 0)" data-current-filter="@(currentFilter ?? string.Empty)">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 py-2">Tên Role</th>
                        <th class="py-2">Quyền (Claims)</th>
                        <th class="py-2">Số tài khoản</th>
                        <th class="py-2 d-none d-lg-table-cell">Role ID</th>
                        <th class="text-end pe-3 py-2" style="width: 240px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var role in Model)
                        {
                            var roleBadgeClass = role.Name == "Admin"
                                ? "bg-danger-subtle text-danger border-danger-subtle"
                                : role.Name == "GiangVien"
                                    ? "bg-warning-subtle text-warning-emphasis border-warning-subtle"
                                    : "bg-primary-subtle text-primary border-primary-subtle";
                            <tr>
                                <td class="ps-3">
                                    <span class="badge @roleBadgeClass border px-2 py-1 fw-semibold">
                                        <i class="bi bi-award me-1"></i>@role.Name
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-shield-check me-1"></i>@role.ClaimCount / @totalSystemPermissions quyền
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                                        <i class="bi bi-people me-1"></i>@role.UserCount tài khoản
                                    </span>
                                </td>
                                <td class="font-monospace small text-muted d-none d-lg-table-cell">@role.Id</td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        @if (canAssignClaim)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-sm py-1 px-2"
                                                    data-modal-url="@Url.Action("AssignClaim", "Role", new { roleId = role.Id })"
                                                    data-modal-size="modal-lg"
                                                    title="Phân quyền động (Claims)">
                                                <i class="bi bi-sliders me-1"></i>Phân quyền
                                            </button>
                                        }
                                        @if (canEdit)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-warning btn-sm py-1 px-2"
                                                    data-modal-url="@Url.Action("Edit", "Role", new { id = role.Id })"
                                                    title="Chỉnh sửa">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        @if (canDelete)
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm py-1 px-2"
                                                    data-modal-url="@Url.Action("Delete", "Role", new { id = role.Id })"
                                                    title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block text-secondary mb-2"></i>
                                @if (!string.IsNullOrEmpty(currentFilter))
                                {
                                    <span>Không tìm thấy Role nào khớp với từ khóa "@currentFilter".</span>
                                }
                                else
                                {
                                    <span>Chưa có Role nào trong hệ thống.</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Thanh phân trang (Pagination Footer) -->
    @if (Model != null && Model.TotalItems > 0)
    {
        <div class="card-footer bg-white py-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-muted small">
                Hiển thị <strong>@Model.StartItemIndex</strong> - <strong>@Model.EndItemIndex</strong> trong tổng số <strong>@Model.TotalItems</strong> vai trò
                <span class="ms-1 text-secondary">(Trang @Model.PageIndex / @Model.TotalPages)</span>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Phân trang danh sách Role">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="1"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               data-ajax-link="true"
                               title="Trang đầu">
                                <i class="bi bi-chevron-double-left"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageIndex - 1)"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               data-ajax-link="true">
                                <i class="bi bi-chevron-left"></i> Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@currentPageSize"
                                   asp-route-searchString="@currentFilter"
                                   data-ajax-link="true">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(Model.PageIndex + 1)"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               data-ajax-link="true">
                                Sau <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@Model.TotalPages"
                               asp-route-pageSize="@currentPageSize"
                               asp-route-searchString="@currentFilter"
                               data-ajax-link="true"
                               title="Trang cuối">
                                <i class="bi bi-chevron-double-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
