@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = "Chi tiết Khoa";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center gap-3">
                <div class="bg-info-subtle text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                    <i class="bi bi-building fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Thông tin Chi tiết Khoa</h5>
                    <small class="text-muted">Xem thông tin khoa đào tạo trong hệ thống</small>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="list-group list-group-flush border rounded-2">
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small fw-semibold"><i class="bi bi-hash me-2 text-primary"></i>Mã Khoa:</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 font-monospace">
                            @Model.FacultyId
                        </span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small fw-semibold"><i class="bi bi-123 me-2 text-secondary"></i>Mã số ngành (2 số):</span>
                        <span class="badge bg-dark-subtle text-dark border px-2 py-1 font-monospace">@Model.FacultyCode</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small fw-semibold"><i class="bi bi-building me-2 text-secondary"></i>Tên Khoa:</span>
                        <span class="fw-bold text-dark">@Model.FacultyName</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <span class="text-muted small fw-semibold"><i class="bi bi-people me-2 text-secondary"></i>Số lượng Sinh viên:</span>
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                            @(Model.Students?.Count ?? 0) sinh viên
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-light d-flex justify-content-between py-3 rounded-bottom-3">
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 rounded-2">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.FacultyId" class="btn btn-warning px-3 py-2 rounded-2 fw-semibold text-dark">
                        <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                    </a>
                }
            </div>
        </div>
    </div>
</div>
