@model DemoMVC.Models.Faculty

@{
    ViewData["Title"] = "Chi tiết Khoa";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-building text-info me-2"></i>Chi tiết Khoa: @Model.FacultyName
                </h5>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Mã Khoa:</dt>
                    <dd class="col-sm-8 fw-bold text-primary">@Model.FacultyId</dd>

                    <dt class="col-sm-4 text-muted">Mã số ngành (2 số):</dt>
                    <dd class="col-sm-8 font-monospace">@Model.FacultyCode</dd>

                    <dt class="col-sm-4 text-muted">Tên Khoa:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.FacultyName</dd>

                    <dt class="col-sm-4 text-muted">Số lượng Sinh viên:</dt>
                    <dd class="col-sm-8">
                        <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">
                            @(Model.Students?.Count ?? 0) sinh viên
                        </span>
                    </dd>
                </dl>
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.FacultyId" class="btn btn-warning btn-sm">
                        <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                    </a>
                </div>
            }
        </div>
    </div>
</div>

