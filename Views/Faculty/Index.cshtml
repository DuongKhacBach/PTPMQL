@model IEnumerable<DemoMVC.Models.Faculty>

@{
    ViewData["Title"] = "Quản lý Khoa - ĐH Mỏ - Địa chất";
}

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-header bg-white py-3 border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <div class="bg-info text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                    <i class="bi bi-building fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-bold text-dark mb-0">Danh sách Khoa (Đại học Mỏ - Địa chất)</h5>
                    <small class="text-muted">Tổng cộng <strong>@(Model?.Count() ?? 0)</strong> khoa đào tạo</small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary btn-sm px-3 rounded-2">
                    <i class="bi bi-people me-1"></i> Quản lý Sinh viên
                </a>
                <a asp-action="Create" class="btn btn-primary btn-sm px-3 rounded-2">
                    <i class="bi bi-plus-lg me-1"></i> Thêm Khoa mới
                </a>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger m-3 py-2 small" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-1"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th class="ps-3 py-2.5" style="width: 140px;">Mã Khoa</th>
                        <th class="py-2.5" style="width: 160px;">Mã số ngành (2 số)</th>
                        <th class="py-2.5">Tên Khoa</th>
                        <th class="py-2.5" style="width: 160px;">Số lượng SV</th>
                        <th class="text-end pe-3 py-2.5" style="width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-primary">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        @item.FacultyId
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-dark-subtle text-dark border px-2 py-1 font-monospace">
                                        @item.FacultyCode
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.FacultyName</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        @(item.Students?.Count ?? 0) sinh viên
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.FacultyId" class="btn btn-outline-warning btn-sm py-1 px-2" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.FacultyId" class="btn btn-outline-danger btn-sm py-1 px-2" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Chưa có khoa nào trong hệ thống.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
