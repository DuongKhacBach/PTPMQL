@model DemoMVC.Models.Faculty

<div class="modal-header bg-warning text-dark">
    <h5 class="modal-title fw-bold" id="crudModalLabel">
        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa thông tin Khoa
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
</div>

<form asp-controller="Faculty" asp-action="Edit" asp-route-id="@Model.FacultyId" method="post" data-ajax-form="true" autocomplete="off">
    <div class="modal-body p-4">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>
        <div class="alert alert-danger py-2 small d-none" data-modal-error role="alert"></div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="FacultyId" class="form-label fw-semibold text-dark small"></label>
                <input asp-for="FacultyId" class="form-control bg-light font-monospace fw-bold text-primary" readonly />
            </div>
            <div class="col-md-6">
                <label asp-for="FacultyCode" class="form-label fw-semibold text-dark small"></label>
                <input asp-for="FacultyCode" class="form-control font-monospace" maxlength="2" data-digits-only="true" required />
                <span asp-validation-for="FacultyCode" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="mb-2">
            <label asp-for="FacultyName" class="form-label fw-semibold text-dark small"></label>
            <input asp-for="FacultyName" class="form-control" required />
            <span asp-validation-for="FacultyName" class="text-danger small mt-1 d-block"></span>
        </div>
    </div>

    <div class="modal-footer bg-light">
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-warning btn-sm px-4 fw-semibold text-dark">
            <i class="bi bi-check2-circle me-1"></i> Cập nhật
        </button>
    </div>
</form>
