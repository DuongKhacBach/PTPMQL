@model DemoMVC.Models.Person

@{
    ViewData["Title"] = "Chỉnh sửa thông tin";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="card-title mb-0 fw-bold">
                    <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa: @Model.PersonId
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <!-- Trường 1: ID (Khóa chính - readonly) -->
                    <div class="mb-3">
                        <label asp-for="PersonId" class="form-label fw-semibold">Mã định danh (ID):</label>
                        <input asp-for="PersonId" class="form-control bg-light" readonly />
                        <span asp-validation-for="PersonId" class="text-danger small"></span>
                        <div class="form-text text-muted">Khóa chính (ID) không thể thay đổi.</div>
                    </div>

                    <!-- Trường 2: Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên:</label>
                        <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên..." required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Trường 3: Địa chỉ -->
                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" placeholder="Nhập địa chỉ..." />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-warning px-4 text-dark fw-semibold">
                            <i class="bi bi-save me-1"></i> Cập nhật thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
