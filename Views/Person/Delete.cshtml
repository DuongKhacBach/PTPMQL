@model DemoMVC.Models.Person

@{
    ViewData["Title"] = "Xác nhận xóa";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0 border-top border-danger border-4">
            <div class="card-header bg-danger bg-opacity-10 text-danger py-3">
                <h4 class="card-title mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Xác nhận xóa Dữ liệu
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-info-circle-fill fs-4 me-2"></i>
                    <div>
                        Bạn có chắc chắn muốn xóa bản ghi này khỏi CSDL SQLite không? Thao tác này <strong>không thể hoàn tác</strong>.
                    </div>
                </div>

                <dl class="row mb-4 bg-light p-3 rounded border">
                    <dt class="col-sm-4 text-muted">Mã định danh (ID):</dt>
                    <dd class="col-sm-8 fw-bold text-primary">
                        @Html.DisplayFor(model => model.PersonId)
                    </dd>

                    <dt class="col-sm-4 text-muted">Họ và tên:</dt>
                    <dd class="col-sm-8 text-dark fw-semibold">
                        @Html.DisplayFor(model => model.FullName)
                    </dd>

                    <dt class="col-sm-4 text-muted">Địa chỉ:</dt>
                    <dd class="col-sm-8 text-dark">
                        @Html.DisplayFor(model => model.Address)
                    </dd>

                    <dt class="col-sm-4 text-muted">Trường học:</dt>
                    <dd class="col-sm-8 text-dark">
                        @Html.DisplayFor(model => model.School)
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="PersonId" />
                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Hủy & Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Xác nhận xóa vĩnh viễn
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
