@model IEnumerable<DemoMVC.Models.Person>

@{
    ViewData["Title"] = "Quản lý dữ liệu Person";
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="card-title fw-bold text-primary mb-1">
                    <i class="bi bi-people-fill me-2"></i>Danh sách Quản lý Dữ liệu
                </h3>
                <p class="text-muted small mb-0">Hệ thống CRUD đồng bộ 4 trường thông tin: ID, Họ tên, Địa chỉ, Trường học</p>
            </div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Thêm mới
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle border">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 15%;">Mã (ID)</th>
                        <th scope="col" style="width: 25%;">Họ và tên</th>
                        <th scope="col" style="width: 25%;">Địa chỉ</th>
                        <th scope="col" style="width: 20%;">Trường học</th>
                        <th scope="col" class="text-center" style="width: 15%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    @Html.DisplayFor(modelItem => item.PersonId)
                                </td>
                                <td class="fw-semibold text-dark">
                                    @Html.DisplayFor(modelItem => item.FullName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Address)
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-building me-1 text-secondary"></i>
                                        @(string.IsNullOrEmpty(item.School) ? "Chưa cập nhật" : item.School)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.PersonId" class="btn btn-outline-warning" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PersonId" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Chưa có dữ liệu nào trong CSDL. Bấm nút <strong>"Thêm mới"</strong> để nhập dữ liệu!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
