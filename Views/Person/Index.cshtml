@model IEnumerable<DemoMVC.Models.Person>

@{
    ViewData["Title"] = "Quản lý dữ liệu Person";
    var currentFilter = ViewData["CurrentFilter"] as string;
    var currentSort = ViewData["CurrentSort"] as string;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
            <div>
                <h3 class="card-title fw-bold text-primary mb-1">
                    <i class="bi bi-people-fill me-2"></i>Danh sách Person
                </h3>
                <p class="text-muted small mb-0">
                    Tổng cộng: <strong>@(Model?.Count() ?? 0)</strong> bản ghi
                    @if (!string.IsNullOrEmpty(currentFilter))
                    {
                        <span>(Tìm kiếm: "<em>@currentFilter</em>")</span>
                    }
                </p>
            </div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Thêm mới
            </a>
        </div>

        <!-- Thanh tìm kiếm LINQ -->
        <form asp-action="Index" method="get" class="row g-2 align-items-center mb-3">
            <input type="hidden" name="sortOrder" value="@currentSort" />
            <div class="col-md-6 col-lg-5">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-light text-muted border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" value="@currentFilter" 
                           class="form-control border-start-0 ps-0" 
                           placeholder="Tìm kiếm theo Tên, Mã ID, Địa chỉ..." />
                    <button type="submit" class="btn btn-primary px-3">Tìm kiếm</button>
                    @if (!string.IsNullOrEmpty(currentFilter))
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle border">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 25%;">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["IdSortParm"]" asp-route-searchString="@currentFilter" class="text-decoration-none text-dark">
                                Mã (ID) <i class="bi bi-arrow-down-up small text-muted"></i>
                            </a>
                        </th>
                        <th scope="col" style="width: 35%;">
                            <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]" asp-route-searchString="@currentFilter" class="text-decoration-none text-dark">
                                Họ và tên <i class="bi bi-arrow-down-up small text-muted"></i>
                            </a>
                        </th>
                        <th scope="col" style="width: 25%;">Địa chỉ</th>
                        <th scope="col" class="text-center" style="width: 15%;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    @Html.DisplayFor(modelItem => item.PersonId)
                                </td>
                                <td class="fw-semibold text-dark">
                                    @Html.DisplayFor(modelItem => item.FullName)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Address)
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.PersonId" class="btn btn-outline-warning" title="Sửa">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.PersonId" class="btn btn-outline-danger" title="Xóa">
                                            <i class="bi bi-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                @if (!string.IsNullOrEmpty(currentFilter))
                                {
                                    <span>Không tìm thấy bản ghi nào khớp với "<strong>@currentFilter</strong>".</span>
                                }
                                else
                                {
                                    <span>Chưa có dữ liệu nào trong CSDL. Bấm nút <strong>"Thêm mới"</strong> để nhập dữ liệu!</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
