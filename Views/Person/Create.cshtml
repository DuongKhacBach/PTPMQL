@model DemoMVC.Models.Person

@{
    ViewData["Title"] = "Thêm mới";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="card-title mb-0 fw-bold">
                    <i class="bi bi-person-plus-fill me-2"></i>Thêm mới Person
                </h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <!-- Trường 1: ID -->
                    <div class="mb-3">
                        <label asp-for="PersonId" class="form-label fw-semibold">Mã định danh (ID):</label>
                        <input asp-for="PersonId" class="form-control" placeholder="Ví dụ: P01" required />
                        <span asp-validation-for="PersonId" class="text-danger small"></span>
                    </div>

                    <!-- Trường 2: Họ và tên -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên:</label>
                        <input asp-for="FullName" class="form-control" placeholder="Ví dụ: Nguyễn Văn A" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Trường 3: Địa chỉ -->
                    <div class="mb-4">
                        <label asp-for="Address" class="form-label fw-semibold">Địa chỉ:</label>
                        <input asp-for="Address" class="form-control" placeholder="Ví dụ: Hà Nội" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Lưu dữ liệu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
