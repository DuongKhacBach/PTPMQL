@{
    int statusCode = ViewData["StatusCode"] is int c ? c : 404;
    var (title, message, icon, badgeClass) = statusCode switch
    {
        403 => ("Từ chối truy cập (403)", "Tài khoản của bạn không có quyền truy cập vào tài nguyên hoặc chức năng này.", "bi-shield-exclamation", "bg-danger-subtle text-danger"),
        400 => ("Yêu cầu không hợp lệ (400)", "Dữ liệu gửi lên không đúng định dạng hoặc phiên làm việc đã hết hạn.", "bi-exclamation-circle", "bg-warning-subtle text-warning-emphasis"),
        500 => ("Lỗi hệ thống (500)", "Máy chủ gặp sự cố ngoài ý muốn khi xử lý yêu cầu. Vui lòng thử lại sau.", "bi-bug-fill", "bg-danger-subtle text-danger"),
        _ => ("Không tìm thấy trang (404)", "Đường dẫn bạn vừa truy cập không tồn tại hoặc nội dung đã bị di chuyển.", "bi-compass", "bg-primary-subtle text-primary")
    };
    ViewData["Title"] = title;
}

<div class="row justify-content-center mt-5">
    <div class="col-md-7 col-lg-6 text-center">
        <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5">
            <div class="mb-3">
                <span class="d-inline-flex align-items-center justify-content-center rounded-circle @badgeClass" style="width: 72px; height: 72px;">
                    <i class="bi @icon fs-1"></i>
                </span>
            </div>
            <h2 class="fw-bold text-dark mb-2">@statusCode</h2>
            <h5 class="fw-semibold text-secondary mb-3">@title</h5>
            <p class="text-muted small mb-4">@message</p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm px-4">
                    <i class="bi bi-house-door me-1"></i> Về Trang chủ
                </a>
                <button type="button" onclick="history.back()" class="btn btn-outline-secondary btn-sm px-3">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại trang trước
                </button>
            </div>
        </div>
    </div>
</div>
