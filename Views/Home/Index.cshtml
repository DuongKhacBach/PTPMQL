@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Trang chủ - Phát triển Phần mềm Quản lý";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool canViewStudents = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Student.Index)).Succeeded;
    bool canViewFaculties = isAuthenticated && (await AuthorizationService.AuthorizeAsync(User, SystemPermissions.Faculty.Index)).Succeeded;
}

<!-- Hero Section -->
<div class="p-5 mb-4 bg-white custom-card text-center">
    <div class="container-fluid py-3">
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 mb-3">
            <i class="bi bi-mortarboard-fill me-1"></i> Môn học: Phát triển Phần mềm Quản lý (HUMG)
        </span>
        <h1 class="display-5 fw-bold text-dark mb-3">Hệ thống Quản lý Sinh viên HUMG</h1>
        <p class="col-md-8 fs-6 text-muted mx-auto mb-4">
            Ứng dụng ASP.NET Core MVC (.NET 10) tích hợp EF Core SQLite, Bootstrap 5 Modal + AJAX CRUD, phân trang &amp; tìm kiếm, xác thực Email MailKit, phân quyền động theo Action và nhập/xuất Excel bằng ClosedXML.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            @if (isAuthenticated)
            {
                @if (canViewStudents)
                {
                    <a asp-controller="Student" asp-action="Index" class="btn btn-primary px-4 py-2">
                        <i class="bi bi-people-fill me-1"></i> Quản lý Sinh viên
                    </a>
                }
                @if (canViewFaculties)
                {
                    <a asp-controller="Faculty" asp-action="Index" class="btn btn-outline-primary px-4 py-2">
                        <i class="bi bi-building me-1"></i> Quản lý Khoa
                    </a>
                }
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập hệ thống
                </a>
                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-primary px-4 py-2">
                    <i class="bi bi-person-plus me-1"></i> Đăng ký tài khoản
                </a>
            }
        </div>
    </div>
</div>

<!-- Feature Grid -->
<div class="row g-4">
    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-3 p-3 mb-3">
                <i class="bi bi-window-stack fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Modal + AJAX CRUD</h5>
            <p class="text-muted small mb-0">
                Toàn bộ thao tác Thêm, Sửa, Xem chi tiết, Xóa, Gán Role và Phân quyền hoạt động mượt mà trên Bootstrap 5 Modal không cần tải lại trang.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-3 p-3 mb-3">
                <i class="bi bi-shield-lock-fill fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Phân quyền động &amp; Xác thực</h5>
            <p class="text-muted small mb-0">
                ASP.NET Core Identity kết hợp Policy-based Permission Claims theo từng Action và xác thực Email / Quên mật khẩu qua MailKit.
            </p>
        </div>
    </div>

    <div class="col-md-4">
        <div class="custom-card p-4 h-100">
            <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle text-success rounded-3 p-3 mb-3">
                <i class="bi bi-file-earmark-excel-fill fs-3"></i>
            </div>
            <h5 class="fw-bold mb-2">Nhập / Xuất Excel thông minh</h5>
            <p class="text-muted small mb-0">
                Hỗ trợ kiểm tra trước tệp Excel (.xlsx), phát hiện trùng khóa chính và lựa chọn chế độ Ghi bổ sung hoặc Ghi đè dữ liệu an toàn.
            </p>
        </div>
    </div>
</div>
